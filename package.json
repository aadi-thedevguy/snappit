{
  "name": "snappit",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.4.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:web": "pnpm --filter '@snappit/web^...' build && pnpm --filter @snappit/web dev",
    "dev:worker": "pnpm --filter '@snappit/video-worker^...' build && pnpm --filter @snappit/video-worker dev",
    "build:web": "pnpm --filter @snappit/web build",
    "build:worker": "pnpm --filter @snappit/video-worker build",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "migrate:storage": "pnpm --filter @snappit/web exec node scripts/migrate-video-storage.js"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.8",
    "turbo": "^2.5.0",
    "typescript": "^5",
    "tsx": "^4.20.0",
    "@types/node": "^22",
    "eslint": "^9",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.9.8"
  }
}
