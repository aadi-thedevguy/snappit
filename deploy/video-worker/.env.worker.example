# Use .env.worker.example for config validation only; copy to .env.worker on the VPS.
# Remove WORKER_ENV_FILE or set it to .env.worker in the real file.
WORKER_ENV_FILE=.env.worker.example
VIDEO_WORKER_IMAGE=snappit-video-worker:test
NODE_ENV=production
# DATABASE_URL=postgresql://example:example@db.example.invalid:5432/snappit
DATABASE_SSL=require
DATABASE_POOL_SIZE=2
INNGEST_DEV=0
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
S3_BUCKET_NAME=
AWS_REGION=us-east-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
APP_VERSION=local-test
WORKER_INSTANCE_ID=snappit-vps-1
WORKER_CONCURRENCY=1
FFMPEG_PATH=/usr/bin/ffmpeg
FFMPEG_TIMEOUT_MS=1800000
MEDIA_TEMP_DIRECTORY=/var/tmp/snappit-media
HEALTH_PORT=8080
